# Email Configuration
# Replace with your actual email credentials

# Email address (QQ or Gmail)
EMAIL_ADDRESS=your_email@example.com

# Email password/authorization code
EMAIL_PASSWORD=your_password_or_auth_code

# Optional: SMTP server settings (will be auto-detected if not specified)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true