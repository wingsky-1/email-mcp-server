# Email Configuration
# Replace with your actual email credentials

# Email address (QQ or Gmail)
EMAIL_ADDRESS=your_email@example.com

# Email password/authorization code
# For QQ Mail: Use authorization code (not password)
# For Gmail: Use app-specific password (not regular password)
EMAIL_PASSWORD=your_password_or_auth_code

# Optional: SMTP server settings (will be auto-detected if not specified)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Optional: Application settings
LOG_LEVEL=INFO
LOG_FILE=email_mcp.log
MAX_ATTACHMENT_SIZE=26214400  # 25MB in bytes
TEMP_DIR=temp
DOWNLOAD_TIMEOUT=30
MAX_RETRIES=3
REQUIRE_CONFIRMATION=false